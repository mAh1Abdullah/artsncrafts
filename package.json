{
  "name": "waw-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo run dev --ui=stream --filter=@waw/dashboard --filter=@waw/storefront",
    "build": "turbo run build",
    "start": "bun --filter @waw/dashboard start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun --filter @waw/dashboard db:generate",
    "db:migrate": "bun --filter @waw/dashboard db:migrate",
    "db:push": "bun --filter @waw/dashboard db:push",
    "db:studio": "bun --filter @waw/dashboard db:studio",
    "db:seed": "bun --filter @waw/dashboard db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5"
  }
}
