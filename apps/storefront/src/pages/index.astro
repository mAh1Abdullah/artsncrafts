---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { HeroIsland } from '../components/HeroIsland';
import { CuratedSectionsIsland } from '../components/CuratedSectionsIsland';
import { CatalogExplorer } from '../components/CatalogExplorer';
import { createServerApiClient } from '../lib/api';
import type { ProductDTO, VendorDTO } from '@waw/contracts';

const api = createServerApiClient();
let products: ProductDTO[] = [];
let vendors: VendorDTO[] = [];

try {
  const [prodRes, vendRes] = await Promise.all([
    api.getProducts({ limit: 48 }),
    api.getVendors({ status: 'approved', limit: 12 }),
  ]);
  products = prodRes.data;
  vendors = vendRes.data;
} catch {
  // Islands hydrate automatically once Next.js REST API is reachable
}

const spotlightProduct =
  products.find((p) => p.category === 'textiles') ?? products[0] ?? null;
---

<StorefrontLayout>
  <!-- Editorial Craft Hero & Category Circles -->
  <HeroIsland client:load spotlightProduct={spotlightProduct} />

  <!-- Curated Editorial Discovery Sections (Editors' Picks, Regional Shops, Gifts) -->
  <CuratedSectionsIsland client:load products={products} vendors={vendors} />

  <!-- Live Catalog Explorer -->
  <section id="collections" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[#C85A32]">
          Curated Archive
        </div>
        <h2 class="mt-1 font-editorial text-3xl sm:text-4xl font-semibold text-[#2E2A25]">
          Explore Handcrafted Pieces
        </h2>
      </div>
      <p class="text-sm text-stone-600 max-w-md">
        Every piece is crafted in small batches and backed by live workshop stock verification and Pathao or Steadfast insured delivery.
      </p>
    </div>

    <CatalogExplorer client:load initialProducts={products} />
  </section>
</StorefrontLayout>
