---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { BuyerAccountIsland } from '../components/BuyerAccountIsland';
import { createServerApiClient } from '../lib/api';
import type { BuyerProfileDTO, OrderDTO, ProductDTO } from '@waw/contracts';

const api = createServerApiClient();
let profile: BuyerProfileDTO | null = null;
let orders: OrderDTO[] = [];
let products: ProductDTO[] = [];

try {
  const [profRes, ordRes, prodRes] = await Promise.all([
    api.getBuyerProfile('buyer-anika'),
    api.getOrders({ buyerUserId: 'buyer-anika', limit: 20 }),
    api.getProducts({ limit: 48 }),
  ]);
  profile = profRes.data;
  orders = ordRes.data;
  products = prodRes.data;
} catch {
  // Island will retry from browser
}
---

<StorefrontLayout
  title="My Account & Orders — The Artisan's Market"
  description="Track your handcrafted shipments, manage style preferences, inspect saved wishlist items, and view your buyer trust standing."
>
  <BuyerAccountIsland
    client:load
    initialProfile={profile}
    initialOrders={orders}
    initialProducts={products}
  />
</StorefrontLayout>
