---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { SellerSignupIsland } from '../components/SellerSignupIsland';
---

<StorefrontLayout
  title="Open an Artisan Studio — The Artisan's Market"
  description="Apply to sell authentic handcrafted pieces on The Artisan's Market with unified WAW-POS stock management and Pathao/Steadfast courier integration."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">
    <div class="space-y-3">
      <div class="text-xs font-semibold uppercase tracking-widest text-[#B84A27]">
        Artisan Onboarding
      </div>
      <h1 class="font-editorial text-4xl font-semibold text-[#221E1B]">
        Share Your Craft Guild With Collectors Everywhere
      </h1>
      <p class="text-base text-[#4A413A] leading-relaxed">
        Verified studios receive a dedicated storefront page, WAW-POS inventory synchronization, automated Pathao & Steadfast consignment booking, and bi-weekly bKash or bank settlements.
      </p>
    </div>

    <SellerSignupIsland client:load />
  </section>
</StorefrontLayout>
