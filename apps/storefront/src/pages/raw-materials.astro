---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { RawMaterialsIsland } from '../components/RawMaterialsIsland';
import { createServerApiClient } from '../lib/api';
import type { RawMaterialDTO } from '@waw/contracts';

const api = createServerApiClient();
let materials: RawMaterialDTO[] = [];

try {
  const res = await api.getRawMaterials();
  materials = res.data;
} catch {
  materials = [];
}
---

<StorefrontLayout
  title="Raw Materials Wholesale — The Artisan's Market"
  description="B2B craft supplies for Bangladeshi artisans: aged Dhamrai clay, 80-count muslin yarn, kiln-dried teak, 925 silver wire, and eco packaging."
>
  <section class="border-b border-[#E5DDD2] bg-[#F3EFE9] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-3">
      <div class="text-xs font-semibold uppercase tracking-widest text-[#B84A27]">
        B2B Craft Supply Network
      </div>
      <h1 class="font-editorial text-4xl font-semibold text-[#221E1B]">
        Wholesale Raw Materials for Workshops
      </h1>
      <p class="text-sm sm:text-base text-[#4A413A] max-w-2xl">
        Source vetted alluvial clay, fine-count pit-loom yarn, seasoned teak, vegetable-tanned hides, and export-grade packaging directly from regional cooperatives with MOQ pricing.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <RawMaterialsIsland client:load initialMaterials={materials} />
  </section>
</StorefrontLayout>
