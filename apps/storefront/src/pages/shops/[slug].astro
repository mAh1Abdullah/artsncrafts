---
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import { VendorShopIsland } from '../../components/VendorShopIsland';
import { createServerApiClient, storefrontPath } from '../../lib/api';
import type { ProductDTO, ReviewDTO, VendorDTO } from '@waw/contracts';

const { slug } = Astro.params;
const api = createServerApiClient();

let vendor: (VendorDTO & { products: ProductDTO[] }) | null = null;
let initialReviews: ReviewDTO[] = [];

if (slug) {
  try {
    const [vendorRes, reviewsRes] = await Promise.all([
      api.getVendor(slug),
      api.getReviews({ status: 'approved' }).catch(() => ({ data: [] as ReviewDTO[] })),
    ]);
    vendor = vendorRes.data;
    const vendorProductIds = new Set(vendor.products.map((p) => p.id));
    initialReviews = reviewsRes.data.filter((r) => vendorProductIds.has(r.productId));
  } catch {
    vendor = null;
  }
}
---

<StorefrontLayout
  title={vendor ? `${vendor.displayName} — Artisan Studio` : "Artisan Studio"}
  description={vendor?.description || "Verified handcrafted studio on The Artisan's Market."}
>
  {vendor ? (
    <VendorShopIsland
      client:load
      vendor={vendor}
      products={vendor.products}
      initialReviews={initialReviews}
    />
  ) : (
    <div class="max-w-3xl mx-auto px-4 py-20 text-center space-y-3">
      <h1 class="font-editorial text-3xl font-semibold text-[#2E2A25]">
        Artisan Studio Not Found
      </h1>
      <p class="text-sm text-stone-600">
        We couldn't find a verified workshop at that address.
      </p>
      <a
        href={storefrontPath('/')}
        class="inline-block mt-2 px-5 py-2.5 rounded-full bg-[#2E2A25] text-white text-sm font-medium"
      >
        Explore All Crafts
      </a>
    </div>
  )}
</StorefrontLayout>
