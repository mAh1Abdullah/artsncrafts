---
import '../styles/global.css';
import { StorefrontHeaderIsland } from '../components/StorefrontHeaderIsland';
import { StorefrontFooter } from '../components/StorefrontFooter';
import { ProductDetailModalIsland } from '../components/ProductDetailModalIsland';
import { CartAndCheckoutIsland } from '../components/CartAndCheckoutIsland';
import { CraftAdvisorIsland } from '../components/CraftAdvisorIsland';
import { ToastIsland } from '../components/ToastIsland';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Artisan's Market — Handcrafted Bangladeshi Heritage",
  description = "Discover museum-grade Jamdani sarees, Dhamrai terracotta, Chittagong teak woodcraft, and Sylhet silver filigree crafted directly by verified workshops.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-KX2S6LDG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAF8F5] text-[#2E2A25] antialiased">
    <StorefrontHeaderIsland client:load currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <StorefrontFooter />

    <!-- Persistent Global React Islands -->
    <ProductDetailModalIsland client:load />
    <CartAndCheckoutIsland client:load />
    <CraftAdvisorIsland client:load />
    <ToastIsland client:load />
  </body>
</html>
